#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'Usage: zbx-ui [*|-a]\n' >&2
}

die() {
  printf 'zbx-ui: %s\n' "$*" >&2
  exit 1
}

open_all=0
if [[ $# -eq 0 ]]; then
  :
elif [[ $# -eq 1 && ( $1 == '-a' || $1 == '*' ) ]]; then
  open_all=1
else
  # An unquoted * is expanded by the calling shell into existing pathnames.
  expanded_star=1
  for argument in "$@"; do
    if [[ ! -e "$argument" ]]; then
      expanded_star=0
      break
    fi
  done

  if (( expanded_star )); then
    open_all=1
  else
    usage
    exit 2
  fi
fi

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) \
  || die 'run this command from inside a Git checkout'
repo_root=$(cd "$repo_root" && pwd -P)
# Local UI routes use the worktree directory, which may differ from the Git ref.
checkout=$(basename "$repo_root")

open_ui() {
  local checkout_name=$1
  local url="http://localhost/branches/$checkout_name/ui"
  printf 'Opening %s\n' "$url"
  open "$url"
}

if (( ! open_all )); then
  open_ui "$checkout"
  exit 0
fi

if [[ ! $checkout =~ ^(.+)-[0-9]+\.[0-9]+$ ]]; then
  die 'checkout directory must end in a version, e.g. ZBX-22925-7.5'
fi
ticket_prefix=${BASH_REMATCH[1]}
# Release worktrees for the same ticket are sibling directories.
branches_root=$(dirname "$repo_root")

shopt -s nullglob
candidate_paths=( "$branches_root/$ticket_prefix"-* )
shopt -u nullglob

opened=0
for path in "${candidate_paths[@]}"; do
  [[ -d "$path" ]] || continue

  candidate=$(basename "$path")
  version=${candidate#"$ticket_prefix"-}
  [[ $version =~ ^[0-9]+\.[0-9]+$ ]] || continue

  open_ui "$candidate"
  opened=$((opened + 1))
done

(( opened > 0 )) || die "no version checkouts found for $ticket_prefix under $branches_root"
