#!/bin/bash

set -u
set -o pipefail

# ============================================================
# Configuration
# ============================================================

JENKINS_URL="https://ci.zabbix.lan"
JENKINS_USER="ggrigorjevs"
JENKINS_KEYCHAIN_SERVICE="jenkins-ci.zabbix.lan"

JIRA_URL="https://support.zabbix.com"
JIRA_USER="ggrigorjevs"
JIRA_KEYCHAIN_SERVICE="jira-support.zabbix.com"

# Temporary workaround for the internal self-signed certificates.
# Prefer configuring your company's internal CA certificate.
CURL_TLS_OPTIONS=(--insecure)

# How long to wait for Jenkins to assign actual build numbers.
QUEUE_TIMEOUT=180
QUEUE_POLL_INTERVAL=2

# How long the background build-status watcher may wait for the builds to
# finish before it records the results it has. Override with RESULT_TIMEOUT.
RESULT_TIMEOUT="${RESULT_TIMEOUT:-43200}"

JOBS=(api frontend frontend-phpunit syntax-check)

# How many recent builds to scan per job when looking for this branch's latest
# build in --rerun-failed mode.
LOOKBACK_BUILDS=50

# When --failures prints a build's console log, keep at most this many lines
# (the tail) so that a very large log cannot flood the output.
MAX_CONSOLE_LINES="${MAX_CONSOLE_LINES:-5000}"

# ============================================================
# Desktop notifications
# ============================================================

# Show a macOS notification; no-op when osascript is unavailable. Arguments
# go through argv, so no AppleScript quoting or escaping is needed.
notify() {
    local title="$1"
    local subtitle="$2"
    local message="$3"

    command -v osascript >/dev/null 2>&1 || return 0

    osascript - "$title" "$subtitle" "$message" \
        >/dev/null 2>&1 <<'APPLESCRIPT' || true
on run argv
    display notification (item 3 of argv) with title (item 1 of argv) subtitle (item 2 of argv) sound name "Basso"
end run
APPLESCRIPT
}

# ============================================================
# Jira comment helpers
# ============================================================

# Map a Jenkins build result to a Jira emoticon. "(?)" means the result is
# not known yet; "(-)" covers results without a dedicated icon.
result_marker() {
    case "$1" in
        SUCCESS) printf '(/)' ;;
        FAILURE) printf '(x)' ;;
        UNSTABLE) printf '(!)' ;;
        '') printf '(?)' ;;
        *) printf '(-)' ;;
    esac
}

# Print the comment section for this branch. Pass "yes" to prefix every link
# with the build's result marker (read from <work dir>/<job>.result). Build
# numbers are read from <work dir>/<job>.build-number.
build_branch_comment() {
    local with_status="$1"
    local api_marker="" frontend_marker="" phpunit_marker="" syntax_marker=""

    if [[ "$with_status" == "yes" ]]; then
        api_marker="$(result_marker "$(cat "$TMP_DIR/api.result" 2>/dev/null)") "
        frontend_marker="$(result_marker "$(cat "$TMP_DIR/frontend.result" 2>/dev/null)") "
        phpunit_marker="$(result_marker "$(cat "$TMP_DIR/frontend-phpunit.result" 2>/dev/null)") "
        syntax_marker="$(result_marker "$(cat "$TMP_DIR/syntax-check.result" 2>/dev/null)") "
    fi

    printf '%s:\n' "$BRANCH"
    printf '* %s[API|%s/job/zabbix-dev/job/api/%s/]\n' \
        "$api_marker" "$JENKINS_URL" "$(cat "$TMP_DIR/api.build-number" 2>/dev/null)"
    printf '* %s[Frontend|%s/job/zabbix-dev/job/frontend/%s/]\n' \
        "$frontend_marker" "$JENKINS_URL" "$(cat "$TMP_DIR/frontend.build-number" 2>/dev/null)"
    printf '* %s[PHPunit|%s/job/zabbix-dev/job/frontend-phpunit/%s/]\n' \
        "$phpunit_marker" "$JENKINS_URL" "$(cat "$TMP_DIR/frontend-phpunit.build-number" 2>/dev/null)"
    printf '* %s[Syntax check|%s/job/zabbix-dev/job/syntax-check/%s/]\n' \
        "$syntax_marker" "$JENKINS_URL" "$(cat "$TMP_DIR/syntax-check.build-number" 2>/dev/null)"
}

# Remove the comment section for this branch, preserving sections for other
# versions. Buffer blank lines so trailing whitespace from a removed section
# does not accumulate between runs.
strip_branch_section() {
    awk -v branch="$BRANCH" '
        $0 == branch ":" {
            skipping = 1
            next
        }

        skipping && /^feature\/[^[:space:]]+:[[:space:]]*$/ {
            skipping = 0
        }

        !skipping {
            if ($0 ~ /^[[:space:]]*$/) {
                blank_lines++
                next
            }

            while (blank_lines > 0) {
                print ""
                blank_lines--
            }

            print
        }
    '
}

# ============================================================
# Background build-status watcher
# ============================================================

# Poll the builds started by the main flow until they finish (or
# RESULT_TIMEOUT elapses), then replace this branch's Jira comment section
# with one that shows each build's status. Runs detached; the main flow
# prepares <state dir> with the curl configs, build numbers and state.env.
watch_build_status() {
    watch_dir="$1"
    watcher_ok=0

    TMP_DIR="$watch_dir"
    JENKINS_CURL_CONFIG="$watch_dir/jenkins-curl.conf"
    JIRA_CURL_CONFIG="$watch_dir/jira-curl.conf"

    watcher_cleanup() {
        rm -f "$JENKINS_CURL_CONFIG" "$JIRA_CURL_CONFIG"
        if (( watcher_ok )); then
            rm -rf "$watch_dir"
        else
            echo "Watcher failed; log kept at $watch_dir/watcher.log"
            notify "Jenkins build watcher failed" "${BRANCH:-unknown branch}" \
                "Could not update the Jira comment; check $watch_dir/watcher.log"
        fi
    }

    trap watcher_cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM

    if [[ ! -f "$watch_dir/state.env" ]]; then
        echo "Error: missing watcher state: $watch_dir/state.env"
        return 1
    fi

    . "$watch_dir/state.env" || {
        echo "Error: could not load watcher state: $watch_dir/state.env"
        return 1
    }

    JIRA_COMMENTS_URL="$JIRA_URL/rest/api/2/issue/$TICKET_KEY/comment"

    local results_elapsed=0 results_pending still_pending job build_number
    local build_json building build_result interval
    local current_comment current_body section_without_branch branch_comment
    local updated_comment status_comment_json status_comment_response
    local status_http status_curl_exit

    echo "Watching Jenkins builds for $BRANCH (up to ${RESULT_TIMEOUT}s)..."

    results_pending="${JOBS[*]}"

    while [[ -n "$results_pending" ]] && (( results_elapsed < RESULT_TIMEOUT )); do
        still_pending=""

        for job in $results_pending; do
            build_number=$(cat "$TMP_DIR/$job.build-number")
            build_json=$(curl "${CURL_TLS_OPTIONS[@]}" \
                --config "$JENKINS_CURL_CONFIG" \
                --silent --show-error \
                --connect-timeout 10 \
                --max-time 20 \
                "$JENKINS_URL/job/zabbix-dev/job/$job/$build_number/api/json?tree=building,result" \
                2>/dev/null) || build_json=""

            building=$(printf '%s' "$build_json" |
                jq -r '.building | tostring' 2>/dev/null)
            build_result=$(printf '%s' "$build_json" |
                jq -r '.result // empty' 2>/dev/null)

            if [[ "$building" == "false" && -n "$build_result" ]]; then
                printf '%s\n' "$build_result" > "$TMP_DIR/$job.result"
                echo "✓ $job: $build_result"

                case "$build_result" in
                    FAILURE)
                        notify "Jenkins build failed" "$BRANCH" \
                            "$job #$build_number finished with FAILURE"
                        ;;
                    UNSTABLE)
                        notify "Jenkins build unstable" "$BRANCH" \
                            "$job #$build_number finished with UNSTABLE"
                        ;;
                esac
            else
                still_pending="${still_pending}${still_pending:+ }$job"
            fi
        done

        results_pending="$still_pending"

        if [[ -n "$results_pending" ]]; then
            # Quick first checks, then back off for long-running builds.
            if (( results_elapsed < 300 )); then
                interval=15
            elif (( results_elapsed < 3600 )); then
                interval=60
            else
                interval=300
            fi

            sleep "$interval"
            results_elapsed=$((results_elapsed + interval))
        fi
    done

    if [[ -n "$results_pending" ]]; then
        echo "✗ Not finished within ${RESULT_TIMEOUT}s: $results_pending"
        echo "  Their links are marked with (?) in the Jira comment."
    fi

    if [[ -z "${COMMENT_ID:-}" ]]; then
        echo "Error: the Jira comment ID is unknown; not adding build statuses."
        return 1
    fi

    # Re-read the comment; if a newer run already replaced this branch's
    # section, leave it alone.
    current_comment=$(curl "${CURL_TLS_OPTIONS[@]}" \
        --config "$JIRA_CURL_CONFIG" \
        --silent --show-error \
        --connect-timeout 10 \
        --max-time 30 \
        "$JIRA_COMMENTS_URL/$COMMENT_ID") || current_comment=""

    current_body=$(printf '%s' "$current_comment" |
        jq -r '.body // empty' 2>/dev/null)

    if [[ -z "$current_body" ]]; then
        echo "Error: could not read the Jira comment back to add build statuses."
        return 1
    fi

    for job in "${JOBS[@]}"; do
        build_number=$(cat "$TMP_DIR/$job.build-number")
        if ! printf '%s' "$current_body" |
            grep -Fq -e "/job/zabbix-dev/job/$job/$build_number/"; then
            echo "The comment section for $BRANCH was replaced by a newer run; leaving it unchanged."
            watcher_ok=1
            return 0
        fi
    done

    section_without_branch=$(printf '%s\n' "$current_body" |
        strip_branch_section)
    branch_comment=$(build_branch_comment yes)
    updated_comment=$(printf '%s\n\n%s' "$section_without_branch" "$branch_comment")

    status_comment_json="$TMP_DIR/status-comment.json"
    status_comment_response="$TMP_DIR/status-comment-response.json"

    printf '%s' "$updated_comment" |
        jq -Rs '{body: .}' > "$status_comment_json" || {
        echo "Error: could not construct the Jira status comment JSON."
        return 1
    }

    status_http=$(curl "${CURL_TLS_OPTIONS[@]}" \
        --config "$JIRA_CURL_CONFIG" \
        --silent --show-error \
        --connect-timeout 10 \
        --max-time 30 \
        --output "$status_comment_response" \
        --write-out '%{http_code}' \
        --request PUT \
        --header "Accept: application/json" \
        --header "Content-Type: application/json" \
        --data-binary "@$status_comment_json" \
        "$JIRA_COMMENTS_URL/$COMMENT_ID")
    status_curl_exit=$?

    if [[ "$status_curl_exit" -ne 0 ]]; then
        echo "Error: could not connect to Jira to add build statuses."
        return 1
    fi

    if [[ "$status_http" != "200" ]]; then
        echo "Error: Jira did not add the build statuses (HTTP $status_http)."
        jq . "$status_comment_response" 2>/dev/null || cat "$status_comment_response"
        return 1
    fi

    echo "✓ Jira build comment updated with build statuses for $BRANCH."
    watcher_ok=1
    return 0
}

# Detached-watcher entry point.
if [[ "${1:-}" == "--watch-status" ]]; then
    if (( $# != 2 )); then
        echo "Usage: jenkins-test --watch-status <state-dir>" >&2
        exit 2
    fi
    watch_build_status "$2"
    exit $?
fi

# ============================================================
# Command-line arguments
# ============================================================

usage() {
    cat <<'EOF'
Usage: jenkins-test [--all] [--rerun-failed | --failures]

Runs the Jenkins jobs (api, frontend, frontend-phpunit, syntax-check) for the
current Git branch, adds the build links to the Jira issue comment and watches
the builds in the background.

Options:
  -a, --all       Process all checked-out version worktrees for the current
                  ZBX ticket. Can be combined with either mode below.
  --rerun-failed  Only trigger jobs whose latest build for this branch failed
                  or does not exist yet; jobs whose latest build succeeded or
                  is still running are kept as-is.
  --failures      Do not trigger anything. Print the failure context of this
                  branch's latest builds: each build's result, the failed
                  tests from its JUnit report and the raw console log of
                  failed builds.
  -h, --help      Show this help.

Environment:
  DRY_RUN=1           Print the plan without contacting Jenkins or Jira.
  RESULT_TIMEOUT=N    How long the build-status watcher may wait for the builds
                      to finish (default: 43200 seconds).
  MAX_CONSOLE_LINES=N How many lines of a failed build's console log
                      --failures prints at most (default: 5000).
EOF
}

RERUN_FAILED=0
SHOW_FAILURES=0
ALL_VERSIONS=0

parse_arguments() {
    while (( $# > 0 )); do
        case "$1" in
            -a|--all)
                ALL_VERSIONS=1
                ;;
            --rerun-failed|--failed)
                RERUN_FAILED=1
                ;;
            --failures)
                SHOW_FAILURES=1
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                printf 'jenkins-test: unknown argument: %s\n\n' "$1" >&2
                usage >&2
                exit 2
                ;;
        esac
        shift
    done
}

parse_arguments "$@"

if (( RERUN_FAILED && SHOW_FAILURES )); then
    printf 'jenkins-test: --rerun-failed and --failures cannot be combined\n\n' >&2
    usage >&2
    exit 2
fi

# ============================================================
# Detect branch, version and Jira ticket
# ============================================================

LOCAL_BRANCH="$(git branch --show-current)"

run_all_versions() {
    local normalized_branch=${LOCAL_BRANCH#feature/}
    local ticket_key self_path record worktree_path="" candidate_branch
    local matched=0 errors=0

    if [[ ! "$normalized_branch" =~ ^(ZBX-[0-9]+)-([0-9]+\.[0-9]+)$ ]]; then
        echo "Error: --all requires a version branch such as ZBX-27915-7.4." >&2
        return 1
    fi
    ticket_key=${BASH_REMATCH[1]}

    self_path=${BASH_SOURCE[0]}
    if [[ "$self_path" != */* ]]; then
        self_path=$(command -v "$self_path") || return 1
    fi
    [[ "$self_path" == /* ]] || self_path="$PWD/$self_path"

    set --
    if (( RERUN_FAILED )); then
        set -- --rerun-failed
    elif (( SHOW_FAILURES )); then
        set -- --failures
    fi

    printf 'Processing checked-out versions of %s...\n' "$ticket_key"

    while IFS= read -r -d '' record; do
        case "$record" in
            'worktree '*) worktree_path=${record#worktree } ;;
            'branch refs/heads/'*)
                candidate_branch=${record#branch refs/heads/}
                normalized_branch=${candidate_branch#feature/}
                if [[ "$normalized_branch" =~ ^(ZBX-[0-9]+)-([0-9]+\.[0-9]+)$ ]] &&
                    [[ "${BASH_REMATCH[1]}" == "$ticket_key" ]]; then
                    matched=$((matched + 1))
                    printf '\nProcessing %s...\n' "$candidate_branch"
                    if ! (cd "$worktree_path" && "$self_path" "$@"); then
                        printf 'Error: Jenkins command failed for %s.\n' "$candidate_branch" >&2
                        errors=1
                    fi
                fi
                ;;
            '') worktree_path="" ;;
        esac
    done < <(git worktree list --porcelain -z)

    if (( matched == 0 )); then
        printf 'Error: no checked-out version branches found for %s.\n' "$ticket_key" >&2
        return 1
    fi

    return "$errors"
}

if (( ALL_VERSIONS )); then
    run_all_versions
    exit $?
fi

# Extract the Jira ticket from the local branch name.
TICKET_KEY="$(printf '%s\n' "$LOCAL_BRANCH" | grep -oE 'ZBX-[0-9]+' | head -n 1)"

# Add feature/ for Jenkins if it isn't already present.
if [[ "$LOCAL_BRANCH" == feature/* ]]; then
    BRANCH="$LOCAL_BRANCH"
else
    BRANCH="feature/$LOCAL_BRANCH"
fi

if [[ -z "$BRANCH" ]]; then
    echo "Error: not inside a Git repository or HEAD is detached."
    exit 1
fi

if (( ! SHOW_FAILURES )); then
    VERSION=$(printf '%s\n' "$BRANCH" |
        sed -nE 's/.*-([0-9]+\.[0-9]+)$/\1/p')

    if [[ -z "$VERSION" ]]; then
        echo "Error: cannot determine version from branch: $BRANCH"
        echo "Expected a branch ending in something like -7.0, -7.4 or -7.5."
        exit 1
    fi

    if [[ -z "$TICKET_KEY" ]]; then
        echo "Error: cannot extract a Jira ticket key from branch: $BRANCH"
        exit 1
    fi

    case "$VERSION" in
        7.0)
            SCREENSHOT_BRANCH="release/7.0"
            ;;
        7.4)
            SCREENSHOT_BRANCH="release/7.4"
            ;;
        *)
            IFS='.' read -r MAJOR MINOR <<< "$VERSION"

            if (( MAJOR > 7 || (MAJOR == 7 && MINOR > 4) )); then
                SCREENSHOT_BRANCH="master"
            else
                echo "Error: no screenshot branch mapping for version $VERSION"
                exit 1
            fi
            ;;
    esac
fi

# ============================================================
# Display plan / dry run
# ============================================================

echo "Git branch:       $BRANCH"

if (( ! SHOW_FAILURES )); then
    echo "Jira ticket:      $TICKET_KEY"
    echo "Screenshot branch: $SCREENSHOT_BRANCH"
fi

echo

if (( ! SHOW_FAILURES )) && [[ "${DRY_RUN:-0}" == "1" ]]; then
    echo "DRY RUN: no builds will be triggered and no Jira comment will be posted."

    if (( RERUN_FAILED )); then
        echo "With --rerun-failed, each job's latest build for this branch would be"
        echo "looked up first and only failed or missing builds would be triggered."
    fi

    echo

    for job in "${JOBS[@]}"; do
        echo "Job: $job"
        echo "  BRANCH=$BRANCH"

        if [[ "$job" == "frontend" ]]; then
            echo "  SCREENSHOT_REFERENCES_BRANCH=$SCREENSHOT_BRANCH"
        fi
        echo
    done

    echo "Jira comment section would contain:"
    echo "Jenkins builds:"
    echo
    echo "$BRANCH:"
    echo "* [API|$JENKINS_URL/job/zabbix-dev/job/api/BUILD_NUMBER/]"
    echo "* [Frontend|$JENKINS_URL/job/zabbix-dev/job/frontend/BUILD_NUMBER/]"
    echo "* [PHPunit|$JENKINS_URL/job/zabbix-dev/job/frontend-phpunit/BUILD_NUMBER/]"
    echo "* [Syntax check|$JENKINS_URL/job/zabbix-dev/job/syntax-check/BUILD_NUMBER/]"
    echo
    echo "A background watcher adds each build's status to the same section once the builds finish."
    exit 0
fi

# ============================================================
# Temporary files and cleanup
# ============================================================

TMP_DIR=$(mktemp -d) || {
    echo "Error: could not create temporary directory."
    exit 1
}

chmod 700 "$TMP_DIR"

cleanup() {
    rm -rf "$TMP_DIR"
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

JENKINS_CURL_CONFIG="$TMP_DIR/jenkins-curl.conf"
JENKINS_COOKIE_JAR="$TMP_DIR/jenkins-cookies.txt"
JIRA_CURL_CONFIG="$TMP_DIR/jira-curl.conf"

# ============================================================
# Retrieve credentials from macOS Keychain
# ============================================================

echo "Retrieving Jenkins credentials from Keychain..."

if ! JENKINS_TOKEN=$(
    security find-generic-password \
        -s "$JENKINS_KEYCHAIN_SERVICE" \
        -a "$JENKINS_USER" \
        -w
); then
    echo "Error: Jenkins token not found in Keychain."
    exit 1
fi

printf 'user = "%s:%s"\n' \
    "$JENKINS_USER" "$JENKINS_TOKEN" > "$JENKINS_CURL_CONFIG"

unset JENKINS_TOKEN
chmod 600 "$JENKINS_CURL_CONFIG"

# Jira is not contacted in --failures mode.
if (( ! SHOW_FAILURES )); then
    echo "Retrieving Jira credentials from Keychain..."

    if ! JIRA_TOKEN=$(
        security find-generic-password \
            -s "$JIRA_KEYCHAIN_SERVICE" \
            -a "$JIRA_USER" \
            -w
    ); then
        echo "Error: Jira token not found in Keychain."
        exit 1
    fi

    # Use Bearer authentication for the Jira Personal Access Token.
    printf 'header = "Authorization: Bearer %s"\n' \
        "$JIRA_TOKEN" > "$JIRA_CURL_CONFIG"

    unset JIRA_TOKEN
    chmod 600 "$JIRA_CURL_CONFIG"
fi

# ============================================================
# Jenkins build lookup
# ============================================================

# Print "<build number> <building> <result>" for this branch's most recent
# build of $job, or nothing when the branch has no build yet. Return non-zero
# when the job's builds cannot be listed.
latest_branch_build() {
    local job="$1"
    local json

    json=$(curl "${CURL_TLS_OPTIONS[@]}" \
        --config "$JENKINS_CURL_CONFIG" \
        --globoff \
        --fail --silent --show-error \
        --connect-timeout 10 \
        --max-time 30 \
        "$JENKINS_URL/job/zabbix-dev/job/$job/api/json?tree=builds[number,building,result,actions[parameters[name,value]]]{0,$LOOKBACK_BUILDS}" \
        2>/dev/null) || return 1

    printf '%s' "$json" |
        jq -r --arg branch "$BRANCH" '
            [.builds[]? | {
                number,
                building,
                result,
                branch: ([.actions[]?.parameters[]?
                    | select(.name == "BRANCH") | .value][0])
            }]
            | map(select(.branch == $branch))[0]
            | select(. != null)
            | "\(.number) \(.building) \(.result // "")"
        ' || return 1
}

# ============================================================
# Failure context (--failures)
# ============================================================

# Print the failures recorded in the JUnit test report of build $2 of job $1.
# The test report holds the failure details for jobs whose console log does
# not, for example the syntax check.
print_build_test_report() {
    local job="$1"
    local build_number="$2"
    local report_file="$TMP_DIR/$job-$build_number.test-report.json"
    local http_status
    local curl_status

    http_status=$(curl "${CURL_TLS_OPTIONS[@]}" \
        --config "$JENKINS_CURL_CONFIG" \
        --globoff \
        --silent --show-error \
        --connect-timeout 10 \
        --max-time 60 \
        --output "$report_file" \
        --write-out '%{http_code}' \
        "$JENKINS_URL/job/zabbix-dev/job/$job/$build_number/testReport/api/json?tree=failCount,passCount,skipCount,suites[cases[className,name,status,errorDetails,errorStackTrace]]")
    curl_status=$?

    if [[ "$curl_status" -ne 0 || "$http_status" != "200" ]]; then
        echo "  Test report: unavailable (HTTP $http_status)"
        return
    fi

    if ! jq -r '
        [.suites[]?.cases[]? |
            select(.status == "FAILED" or .status == "REGRESSION")] as $failed
        | "  Test report: \(.failCount // ($failed | length)) failed, \(.passCount // 0) passed, \(.skipCount // 0) skipped",
          (if ($failed | length) == 0 then
              "  Failed tests: none recorded in the test report"
           else
              "  Failed tests:",
              ($failed[] as $case
               | "    - \($case.className)::\($case.name)",
                 (($case.errorStackTrace // $case.errorDetails //
                   $case.stdout // $case.stderr // "")
                  | select(length > 0)
                  | split("\n")[]
                  | "      \(.)"))
           end)
    ' "$report_file"; then
        echo "  Test report: could not be read"
    fi
}

# Print the raw console log of build $2 of job $1, keeping only the last
# MAX_CONSOLE_LINES lines when the log is larger.
print_build_console_log() {
    local job="$1"
    local build_number="$2"
    local console_file="$TMP_DIR/$job-$build_number.console.txt"
    local console_url="$JENKINS_URL/job/zabbix-dev/job/$job/$build_number/consoleText"
    local http_status
    local curl_status
    local total_lines

    http_status=$(curl "${CURL_TLS_OPTIONS[@]}" \
        --config "$JENKINS_CURL_CONFIG" \
        --silent --show-error \
        --connect-timeout 10 \
        --max-time 120 \
        --output "$console_file" \
        --write-out '%{http_code}' \
        "$console_url")
    curl_status=$?

    if [[ "$curl_status" -ne 0 || "$http_status" != "200" ]]; then
        echo "  Console log: unavailable (HTTP $http_status)"
        return
    fi

    total_lines=$(wc -l < "$console_file")
    total_lines="${total_lines//[[:space:]]/}"

    echo "---- $job #$build_number console log (start) ----"

    if [[ "$total_lines" =~ ^[0-9]+$ ]] && (( total_lines > MAX_CONSOLE_LINES )); then
        echo "[showing the last $MAX_CONSOLE_LINES of $total_lines lines; complete log: $console_url]"
        tail -n "$MAX_CONSOLE_LINES" "$console_file"
    else
        cat "$console_file"
    fi

    echo "---- $job #$build_number console log (end) ----"
}

# Print this branch's latest build of each job with its failure context: the
# build result, the JUnit test report failures with their error details and
# the raw console log of failed builds.
show_failure_context() {
    local job info build_number building build_result
    local failed_builds="" pending_builds="" missing_builds=""

    echo "Failure context for $BRANCH"
    echo

    for job in "${JOBS[@]}"; do
        if ! info=$(latest_branch_build "$job"); then
            echo "Error: could not list the latest $job builds from Jenkins."
            exit 1
        fi

        if [[ -z "$info" ]]; then
            printf '%s: no recent build on this branch\n\n' "$job"
            missing_builds="${missing_builds}${missing_builds:+, }$job"
            continue
        fi

        read -r build_number building build_result <<< "$info"

        if [[ "$building" == "true" ]]; then
            printf '%s: build #%s is still running\n\n' "$job" "$build_number"
            pending_builds="${pending_builds}${pending_builds:+, }$job #$build_number"
            continue
        fi

        if [[ "$build_result" == "SUCCESS" ]]; then
            printf '%s: build #%s succeeded\n\n' "$job" "$build_number"
            continue
        fi

        failed_builds="${failed_builds}${failed_builds:+, }$job #$build_number (${build_result:-unknown result})"

        printf '%s: build #%s ended with %s\n' \
            "$job" "$build_number" "${build_result:-an unknown result}"
        printf '  URL: %s/job/zabbix-dev/job/%s/%s/\n' \
            "$JENKINS_URL" "$job" "$build_number"

        print_build_test_report "$job" "$build_number"
        echo
        print_build_console_log "$job" "$build_number"
        echo
    done

    if [[ -n "$failed_builds" ]]; then
        printf 'Failed builds: %s\n' "$failed_builds"
    else
        printf 'No failed builds for %s.\n' "$BRANCH"
    fi

    if [[ -n "$pending_builds" ]]; then
        printf 'Still running: %s\n' "$pending_builds"
    fi

    if [[ -n "$missing_builds" ]]; then
        printf 'No recent build on this branch: %s\n' "$missing_builds"
    fi

    if [[ -n "$failed_builds" ]]; then
        printf 'After pushing a fix, rerun them with: zb j --rerun-failed\n'
    fi
}

if (( SHOW_FAILURES )); then
    show_failure_context
    exit 0
fi

# ============================================================
# Retrieve Jenkins CSRF crumb
# ============================================================

echo
echo "Authenticating with Jenkins..."

CRUMB_JSON=$(curl "${CURL_TLS_OPTIONS[@]}" \
    --config "$JENKINS_CURL_CONFIG" \
    --cookie-jar "$JENKINS_COOKIE_JAR" \
    --fail --silent --show-error \
    "$JENKINS_URL/crumbIssuer/api/json") || {
    echo "Error: could not retrieve Jenkins CSRF crumb."
    exit 1
}

CRUMB_FIELD=$(printf '%s' "$CRUMB_JSON" |
    jq -r '.crumbRequestField // empty')

CRUMB=$(printf '%s' "$CRUMB_JSON" |
    jq -r '.crumb // empty')

if [[ -z "$CRUMB_FIELD" || -z "$CRUMB" ]]; then
    echo "Error: Jenkins returned an invalid CSRF crumb."
    exit 1
fi

echo "Jenkins authentication successful."

# ============================================================
# Pick the jobs to trigger (--rerun-failed only)
# ============================================================

TRIGGER_JOBS=("${JOBS[@]}")
REUSE_JOBS=()

if (( RERUN_FAILED )); then
    TRIGGER_JOBS=()

    echo
    echo "Checking the latest build of each job for $BRANCH..."

    for job in "${JOBS[@]}"; do
        if ! info=$(latest_branch_build "$job"); then
            echo "Error: could not list the latest $job builds from Jenkins."
            echo "No builds were triggered."
            exit 1
        fi

        if [[ -z "$info" ]]; then
            printf '  %-17s no build on this branch; rerunning\n' "$job"
            TRIGGER_JOBS+=("$job")
            continue
        fi

        read -r build_number building build_result <<< "$info"

        if [[ "$building" == "true" ]]; then
            printf '  %-17s build #%s is still running; reusing\n' \
                "$job" "$build_number"
            printf '%s\n' "$build_number" > "$TMP_DIR/$job.build-number"
            REUSE_JOBS+=("$job")
        elif [[ "$build_result" == "SUCCESS" ]]; then
            printf '  %-17s build #%s succeeded; reusing\n' \
                "$job" "$build_number"
            printf '%s\n' "$build_number" > "$TMP_DIR/$job.build-number"
            REUSE_JOBS+=("$job")
        else
            printf '  %-17s build #%s ended with %s; rerunning\n' \
                "$job" "$build_number" "${build_result:-an unknown result}"
            TRIGGER_JOBS+=("$job")
        fi
    done

    if (( ${#TRIGGER_JOBS[@]} == 0 )); then
        echo
        echo "✓ No failed builds for $BRANCH; nothing was triggered."
        echo "  The Jira comment was left unchanged."
        exit 0
    fi
fi

# ============================================================
# Trigger Jenkins jobs
# ============================================================

trigger_job() {
    local job="$1"
    local headers="$TMP_DIR/$job.headers"
    local error_file="$TMP_DIR/$job.error"
    local status_file="$TMP_DIR/$job.status"
    local http_status
    local curl_status
    local -a params

    params=(
        --data-urlencode "BRANCH=$BRANCH"
    )

    if [[ "$job" == "frontend" ]]; then
        params+=(
            --data-urlencode \
                "SCREENSHOT_REFERENCES_BRANCH=$SCREENSHOT_BRANCH"
        )
    fi

    echo "Triggering $job..."

    http_status=$(curl "${CURL_TLS_OPTIONS[@]}" \
        --config "$JENKINS_CURL_CONFIG" \
        --cookie "$JENKINS_COOKIE_JAR" \
        --silent --show-error \
        --output /dev/null \
        --dump-header "$headers" \
        --write-out '%{http_code}' \
        --connect-timeout 10 \
        --max-time 30 \
        -H "$CRUMB_FIELD: $CRUMB" \
        "${params[@]}" \
        "$JENKINS_URL/job/zabbix-dev/job/$job/buildWithParameters" \
        2>"$error_file")

    curl_status=$?

    if [[ "$curl_status" -ne 0 ]]; then
        http_status="000"
    fi

    printf '%s\n' "$http_status" > "$status_file"

    if [[ "$http_status" =~ ^2[0-9][0-9]$ ]]; then
        # Jenkins normally returns a Location header pointing to the
        # queue item created by the build request.
        awk '
            tolower($1) == "location:" {
                sub(/\r$/, "");
                sub(/^[^:]*:[[:space:]]*/, "");
                location = $0;
            }
            END {
                print location;
            }
        ' "$headers" > "$TMP_DIR/$job.queue-url"
    else
        echo "Failed to trigger $job (HTTP $http_status)." \
            > "$TMP_DIR/$job.trigger-error"
    fi
}

echo
if (( RERUN_FAILED )); then
    echo "Triggering failed jobs only: ${TRIGGER_JOBS[*]}..."
else
    echo "Triggering all four Jenkins jobs..."
fi

for job in "${TRIGGER_JOBS[@]}"; do
    trigger_job "$job" &
done

wait || true

# ============================================================
# Check that every build was queued successfully
# ============================================================

TRIGGER_FAILED=0

echo
echo "Checking Jenkins queue responses..."

for job in "${TRIGGER_JOBS[@]}"; do
    status=$(cat "$TMP_DIR/$job.status" 2>/dev/null || echo "000")

    if [[ ! "$status" =~ ^2[0-9][0-9]$ ]]; then
        echo "✗ $job: request failed (HTTP $status)"

        if [[ -f "$TMP_DIR/$job.error" ]]; then
            cat "$TMP_DIR/$job.error"
        fi

        TRIGGER_FAILED=1
        continue
    fi

    queue_url=$(cat "$TMP_DIR/$job.queue-url" 2>/dev/null || true)

    if [[ -z "$queue_url" ]]; then
        echo "✗ $job: Jenkins did not return a queue URL."
        TRIGGER_FAILED=1
        continue
    fi

    # Handle relative Location headers if Jenkins returns one.
    if [[ "$queue_url" == /* ]]; then
        queue_url="$JENKINS_URL$queue_url"
    fi

    printf '%s\n' "$queue_url" > "$TMP_DIR/$job.queue-url"

    echo "✓ $job: accepted by Jenkins."
done

if [[ "$TRIGGER_FAILED" -ne 0 ]]; then
    echo
    echo "Error: one or more build requests failed."
    echo "Not posting a Jira comment because not all requested builds were queued."
    exit 1
fi

# ============================================================
# Wait for Jenkins to assign build numbers
# ============================================================

echo
echo "Waiting for Jenkins to assign build numbers..."

BUILD_FAILED=0

for job in "${TRIGGER_JOBS[@]}"; do
    queue_url=$(cat "$TMP_DIR/$job.queue-url")
    queue_api="${queue_url%/}/api/json"

    elapsed=0
    build_number=""

    while (( elapsed < QUEUE_TIMEOUT )); do
        queue_json=$(curl "${CURL_TLS_OPTIONS[@]}" \
            --config "$JENKINS_CURL_CONFIG" \
            --silent --show-error \
            --connect-timeout 10 \
            --max-time 20 \
            "$queue_api" 2>/dev/null) || queue_json=""

        if [[ -n "$queue_json" ]]; then
            build_number=$(printf '%s' "$queue_json" |
                jq -r '.executable.number // empty' 2>/dev/null)

            cancelled=$(printf '%s' "$queue_json" |
                jq -r '.cancelled // false' 2>/dev/null)

            if [[ "$cancelled" == "true" ]]; then
                echo "✗ $job: Jenkins queue item was cancelled."
                break
            fi

            if [[ "$build_number" =~ ^[0-9]+$ ]]; then
                printf '%s\n' "$build_number" \
                    > "$TMP_DIR/$job.build-number"

                echo "✓ $job: build #$build_number"
                break
            fi
        fi

        sleep "$QUEUE_POLL_INTERVAL"
        elapsed=$((elapsed + QUEUE_POLL_INTERVAL))
    done

    if [[ ! "$build_number" =~ ^[0-9]+$ ]]; then
        echo "✗ $job: no build number received within the timeout."
        BUILD_FAILED=1
    fi
done

if [[ "$BUILD_FAILED" -ne 0 ]]; then
    echo
    echo "Error: not all builds received build numbers."
    echo "No Jira comment was posted."
    echo "Some builds may still be queued or running. Check Jenkins."
    exit 1
fi

# ============================================================
# Construct Jira comment
# ============================================================

API_BUILD=$(cat "$TMP_DIR/api.build-number")
FRONTEND_BUILD=$(cat "$TMP_DIR/frontend.build-number")
PHPUNIT_BUILD=$(cat "$TMP_DIR/frontend-phpunit.build-number")
SYNTAX_BUILD=$(cat "$TMP_DIR/syntax-check.build-number")

BRANCH_COMMENT=$(build_branch_comment no)

JIRA_COMMENTS_URL="$JIRA_URL/rest/api/2/issue/$TICKET_KEY/comment"
EXISTING_COMMENT_ID=""
EXISTING_COMMENT_BODY=""
COMMENT_START_AT=0

# Read comments page by page so an older Jenkins build comment is not missed.
while :; do
    COMMENTS_PAGE="$TMP_DIR/jira-comments-$COMMENT_START_AT.json"

    COMMENTS_HTTP_STATUS=$(curl "${CURL_TLS_OPTIONS[@]}" \
        --config "$JIRA_CURL_CONFIG" \
        --silent --show-error \
        --connect-timeout 10 \
        --max-time 30 \
        --output "$COMMENTS_PAGE" \
        --write-out '%{http_code}' \
        "$JIRA_COMMENTS_URL?startAt=$COMMENT_START_AT&maxResults=100")

    CURL_STATUS=$?

    if [[ "$CURL_STATUS" -ne 0 ]]; then
        echo "Error: could not retrieve Jira comments for $TICKET_KEY."
        echo "The Jenkins builds have already been queued."
        exit 1
    fi

    if [[ "$COMMENTS_HTTP_STATUS" != "200" ]]; then
        echo "Error: Jira comment lookup failed (HTTP $COMMENTS_HTTP_STATUS)."
        jq . "$COMMENTS_PAGE" 2>/dev/null || cat "$COMMENTS_PAGE"
        echo "The Jenkins builds have already been queued."
        exit 1
    fi

    if ! jq -e '.comments | type == "array"' "$COMMENTS_PAGE" >/dev/null; then
        echo "Error: Jira returned an invalid comments response."
        echo "The Jenkins builds have already been queued."
        exit 1
    fi

    COMMENT_TOTAL=$(jq -r '.total // 0' "$COMMENTS_PAGE")
    COMMENTS_ON_PAGE=$(jq -r '.comments | length' "$COMMENTS_PAGE")

    if [[ ! "$COMMENT_TOTAL" =~ ^[0-9]+$ ||
          ! "$COMMENTS_ON_PAGE" =~ ^[0-9]+$ ]]; then
        echo "Error: Jira returned invalid comment pagination details."
        echo "The Jenkins builds have already been queued."
        exit 1
    fi

    MATCHING_COMMENT=$(jq -c '
        [.comments[]? |
            select(((.body // "") | tostring) |
                startswith("Jenkins builds:"))]
        | last // empty
    ' "$COMMENTS_PAGE")

    if [[ -n "$MATCHING_COMMENT" ]]; then
        MATCHING_COMMENT_ID=$(printf '%s' "$MATCHING_COMMENT" |
            jq -r '(.id // "") | tostring')

        if [[ ! "$MATCHING_COMMENT_ID" =~ ^[0-9]+$ ]]; then
            echo "Error: the existing Jenkins build comment has an invalid ID."
            echo "The Jenkins builds have already been queued."
            exit 1
        fi

        EXISTING_COMMENT_ID="$MATCHING_COMMENT_ID"
        EXISTING_COMMENT_BODY=$(printf '%s' "$MATCHING_COMMENT" |
            jq -r '.body // ""')
    fi

    COMMENT_START_AT=$((COMMENT_START_AT + COMMENTS_ON_PAGE))

    if (( COMMENTS_ON_PAGE == 0 || COMMENT_START_AT >= COMMENT_TOTAL )); then
        break
    fi
done

if [[ -n "$EXISTING_COMMENT_ID" ]]; then
    # Replace every prior section for this branch, preserving sections for
    # other versions.
    COMMENT_WITHOUT_BRANCH=$(printf '%s\n' "$EXISTING_COMMENT_BODY" |
        strip_branch_section)

    COMMENT=$(printf '%s\n\n%s' "$COMMENT_WITHOUT_BRANCH" "$BRANCH_COMMENT")
    JIRA_COMMENT_METHOD="PUT"
    JIRA_COMMENT_ACTION="updated"
    JIRA_COMMENT_URL="$JIRA_COMMENTS_URL/$EXISTING_COMMENT_ID"
    JIRA_EXPECTED_STATUS="200"
    echo "Updating Jenkins build comment #$EXISTING_COMMENT_ID (replacing links for $BRANCH)..."
else
    COMMENT=$(printf 'Jenkins builds:\n\n%s' "$BRANCH_COMMENT")
    JIRA_COMMENT_METHOD="POST"
    JIRA_COMMENT_ACTION="created"
    JIRA_COMMENT_URL="$JIRA_COMMENTS_URL"
    JIRA_EXPECTED_STATUS="201"
    echo "Creating a Jenkins build comment..."
fi

echo
echo "Jira comment content:"
echo
printf '%s\n' "$COMMENT"
echo

# ============================================================
# Create or update Jira comment
# ============================================================

COMMENT_JSON="$TMP_DIR/comment.json"

printf '%s' "$COMMENT" |
    jq -Rs '{body: .}' > "$COMMENT_JSON" || {
    echo "Error: could not construct Jira comment JSON."
    echo "The Jenkins builds have already been queued."
    exit 1
}

JIRA_RESPONSE="$TMP_DIR/jira-response.json"

JIRA_HTTP_STATUS=$(curl "${CURL_TLS_OPTIONS[@]}" \
    --config "$JIRA_CURL_CONFIG" \
    --silent --show-error \
    --connect-timeout 10 \
    --max-time 30 \
    --output "$JIRA_RESPONSE" \
    --write-out '%{http_code}' \
    --request "$JIRA_COMMENT_METHOD" \
    --header "Accept: application/json" \
    --header "Content-Type: application/json" \
    --data-binary "@$COMMENT_JSON" \
    "$JIRA_COMMENT_URL")

CURL_STATUS=$?

if [[ "$CURL_STATUS" -ne 0 ]]; then
    echo "Error: could not connect to Jira."
    echo "The Jenkins builds have already been queued."
    exit 1
fi

if [[ "$JIRA_HTTP_STATUS" != "$JIRA_EXPECTED_STATUS" ]]; then
    echo "Error: Jira did not $JIRA_COMMENT_ACTION the Jenkins build comment (HTTP $JIRA_HTTP_STATUS)."
    echo "Response:"
    jq . "$JIRA_RESPONSE" 2>/dev/null || cat "$JIRA_RESPONSE"
    echo
    echo "The Jenkins builds have already been queued."
    exit 1
fi

COMMENT_ID=$(jq -r '.id // empty' "$JIRA_RESPONSE")

if [[ -z "$COMMENT_ID" ]]; then
    COMMENT_ID="$EXISTING_COMMENT_ID"
fi

echo
if (( RERUN_FAILED )); then
    echo "✓ Jenkins builds queued: ${TRIGGER_JOBS[*]}"

    if (( ${#REUSE_JOBS[@]} > 0 )); then
        echo "  Reused previous builds: ${REUSE_JOBS[*]}"
    fi
else
    echo "✓ All four Jenkins builds were queued."
fi
echo "✓ Jira build comment $JIRA_COMMENT_ACTION successfully."
echo "  Ticket: $JIRA_URL/browse/$TICKET_KEY"

if [[ -n "$COMMENT_ID" ]]; then
    echo "  Comment ID: $COMMENT_ID"
fi

# ============================================================
# Watch the builds in the background and update the comment
# ============================================================

watch_ready=1
WATCH_DIR=$(mktemp -d "${TMPDIR:-/tmp}/jenkins-test-watch.XXXXXX" 2>/dev/null || true)

if [[ -n "$WATCH_DIR" ]]; then
    chmod 700 "$WATCH_DIR"
    watch_ready=0

    for job in "${JOBS[@]}"; do
        cp "$TMP_DIR/$job.build-number" "$WATCH_DIR/$job.build-number" || watch_ready=1
    done
    cp "$JENKINS_CURL_CONFIG" "$WATCH_DIR/jenkins-curl.conf" || watch_ready=1
    cp "$JIRA_CURL_CONFIG" "$WATCH_DIR/jira-curl.conf" || watch_ready=1

    if (( watch_ready == 0 )); then
        chmod 600 "$WATCH_DIR/jenkins-curl.conf" "$WATCH_DIR/jira-curl.conf" \
            || watch_ready=1
    fi

    if (( watch_ready == 0 )); then
        {
            printf 'TICKET_KEY=%q\n' "$TICKET_KEY"
            printf 'COMMENT_ID=%q\n' "$COMMENT_ID"
            printf 'BRANCH=%q\n' "$BRANCH"
            printf 'RESULT_TIMEOUT=%q\n' "$RESULT_TIMEOUT"
        } > "$WATCH_DIR/state.env" || watch_ready=1
    fi

    if (( watch_ready == 0 )); then
        SELF_PATH="${BASH_SOURCE[0]}"
        if [[ "$SELF_PATH" != */* ]]; then
            if command -v "$SELF_PATH" >/dev/null 2>&1; then
                SELF_PATH=$(command -v "$SELF_PATH")
            elif [[ -f "$SELF_PATH" ]]; then
                SELF_PATH="$(pwd -P)/$SELF_PATH"
            else
                SELF_PATH=''
            fi
        elif [[ "$SELF_PATH" != /* ]]; then
            SELF_PATH="$(pwd -P)/$SELF_PATH"
        fi

        if [[ -z "$SELF_PATH" ]]; then
            watch_ready=1
        fi
    fi
fi

if (( watch_ready != 0 )); then
    if [[ -n "$WATCH_DIR" ]]; then
        rm -rf "$WATCH_DIR"
    fi
    echo "Warning: could not start the background build-status watcher; check the build links in $JIRA_URL/browse/$TICKET_KEY later." >&2
else
    nohup "$SELF_PATH" --watch-status "$WATCH_DIR" \
        >>"$WATCH_DIR/watcher.log" 2>&1 </dev/null &
    disown 2>/dev/null || true

    echo
    echo "✓ A background watcher will add the build statuses to the Jira comment."
    echo "  Failed or unstable builds trigger a desktop notification."
    echo "  Watcher log: $WATCH_DIR/watcher.log"
fi

echo
echo "Build URLs:"
echo "  API:          $JENKINS_URL/job/zabbix-dev/job/api/$API_BUILD/"
echo "  Frontend:     $JENKINS_URL/job/zabbix-dev/job/frontend/$FRONTEND_BUILD/"
echo "  PHPunit:      $JENKINS_URL/job/zabbix-dev/job/frontend-phpunit/$PHPUNIT_BUILD/"
echo "  Syntax check: $JENKINS_URL/job/zabbix-dev/job/syntax-check/$SYNTAX_BUILD/"
