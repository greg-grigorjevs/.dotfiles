{
	"$schema": "https://opencode.ai/v2/cli.json",
	"keybinds": {
		"session.message.user.previous": "alt+up",
		"session.message.user.next": "alt+down",
		"session.tab.next": "alt+d",
		"session.tab.previous": "alt+l",
		"prompt.skills": "ctrl+alt+h",
		"session.list": "ctrl+s",
		"session.new": "ctrl+n",
		"session.half.page.down": "ctrl+d",
		"session.half.page.up": "ctrl+u",
		"app.exit": "ctrl+c",
		"input.newline": "ctrl+j,shift+return",
		"model.list": "ctrl+m"
	},
	"tabs": {
		"layout": "horizontal",
		"mode": "on",
		"scope": "cwd"
	},
	"attention": {
		"sound": true,
		"volume": 0.1
	},
	"theme": {
		"name": "opencode"
	},
	"session": {
    "sidebar": "auto",
    "thinking": "hide"
	},
	"diffs": {
		"view": "auto",
		"wrap": "word",
		"tree": true,
		"single": false
	}
}
